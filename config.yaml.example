server:
  port: 8080
  host: "0.0.0.0"

database:
  path: ./data/triggermesh.db  # Recommended: use data/ directory for database files

jenkins:
  default: primary
  instances:
    primary:
      url: https://your-primary-jenkins-url
      username: your-primary-jenkins-username
      token: your-primary-jenkins-token
      timeout: 30  # Optional; defaults to 30 seconds
    secondary:
      url: https://your-secondary-jenkins-url
      username: your-secondary-jenkins-username
      token: your-secondary-jenkins-token

# A request may select an instance by name. Otherwise TriggerMesh checks all
# instances and triggers only if exactly one contains the requested job.

api:
  keys:
    - your-api-key
